{
  "name": "@szorako/engine",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build-dict": "node scripts/build-dict.mjs",
    "build": "npm run build-dict && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "dictionary-hu": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
